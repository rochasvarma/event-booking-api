# Copy to .env (docker compose reads it) or set as environment variables.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eventbooking
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# baseline | optimized
BOOKING_MODE=optimized
VIRTUAL_THREADS=true
DB_POOL_SIZE=10

# brevo-api | smtp
EMAIL_PROVIDER=brevo-api
BREVO_API_KEY=xkeysib-...
EMAIL_FROM=you@yourdomain.com
EMAIL_FROM_NAME=Event Booking

# Only for EMAIL_PROVIDER=smtp (e.g. Gmail with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
